# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string

# Admin credentials (hashed password stored at first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Database path (relative to app root)
DB_PATH=metascreener.db

# Upload settings
MAX_UPLOAD_MB=50
UPLOAD_FOLDER=uploads

# AI Provider: ollama | openai | anthropic | gemini | openai_compatible
AI_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=mistral

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI-Compatible (Groq, Together, LM Studio, etc.) ---
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# Rate limits
RATE_LIMIT_DEFAULT=200 per day, 50 per hour
RATE_LIMIT_AI=30 per hour
